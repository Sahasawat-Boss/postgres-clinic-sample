generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id             Int      @id @default(autoincrement())
  patient_id     Int
  doctor_id      Int
  appointment_at DateTime @db.Timestamptz(6)
  status         String   @default("scheduled") @db.VarChar(20)
  reason         String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  doctors        doctors  @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients       patients @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  visits         visits[]

  @@index([patient_id], map: "idx_appointments_patient")
  @@index([appointment_at], map: "idx_appointments_time")
}

model doctors {
  id           Int            @id @default(autoincrement())
  first_name   String         @db.VarChar(100)
  last_name    String         @db.VarChar(100)
  specialty    String?        @db.VarChar(100)
  phone        String?        @db.VarChar(20)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  appointments appointments[]
  visits       visits[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model patients {
  id            Int            @id @default(autoincrement())
  hn            String         @unique @db.VarChar(20)
  first_name    String         @db.VarChar(100)
  last_name     String         @db.VarChar(100)
  gender        String?        @db.VarChar(10)
  date_of_birth DateTime       @db.Date
  phone         String?        @db.VarChar(20)
  email         String?        @db.VarChar(255)
  address       String?
  blood_type    String?        @db.VarChar(3)
  allergies     String?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  appointments  appointments[]
  visits        visits[]

  @@index([first_name, last_name], map: "idx_patients_name")
  @@index([phone], map: "idx_patients_phone")
}

model visits {
  id             Int           @id @default(autoincrement())
  patient_id     Int
  doctor_id      Int
  appointment_id Int?
  visit_at       DateTime      @default(now()) @db.Timestamptz(6)
  symptoms       String?
  diagnosis      String?
  treatment      String?
  fee            Decimal?      @default(0) @db.Decimal(10, 2)
  appointments   appointments? @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctors        doctors       @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients       patients      @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patient_id], map: "idx_visits_patient")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  name          String   @db.VarChar(100)
  role          String   @default("staff") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}
